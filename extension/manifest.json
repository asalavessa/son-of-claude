{
  "manifest_version": 3,
  "name": "Son of Claude Watcher",
  "version": "1.0",
  "description": "Monitors Teams for unread activity and triggers Claude CLI.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://teams.microsoft.com/*", "https://teams.cloud.microsoft/*", "http://127.0.0.1:3000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Son of Claude"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://teams.microsoft.com/*", "https://teams.cloud.microsoft/*"],
      "js": ["content.js"]
    }
  ]
}
